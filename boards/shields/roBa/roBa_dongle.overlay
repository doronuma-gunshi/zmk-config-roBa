#include <dt-bindings/zmk/matrix_transform.h>
#include "roBa.dtsi"

/* roBa.dtsi で定義された元の物理 kscan ノードを削除してラベル重複を回避 */
/delete-node/ &kscan0;

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    /* 物理レイアウトと chosen の両方が参照するダミーノード */
    kscan0: mock_kscan {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};
