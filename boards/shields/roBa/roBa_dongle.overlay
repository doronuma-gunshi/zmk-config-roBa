#include <dt-bindings/zmk/matrix_transform.h>
#include "roBa.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,matrix-transform = &default_transform;
    };

    mock_kscan: mock_kscan {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};

/* 物理レイアウトのキースキャン参照先を新設したダミーノードに上書き */
&roba_physical_layout {
    kscan = <&mock_kscan>;
};

/* roBa.dtsiで定義されている元の物理マトリクスは使わないため無効化 */
&kscan0 {
    status = "disabled";
};
