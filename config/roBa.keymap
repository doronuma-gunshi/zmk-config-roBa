#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    zip_xy_scaler: zip_xy_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_X INPUT_REL_Y>;
    };
};

&mt {
    flavor = "balanced";
    tapping-term-ms = <175>;
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <4>;

    scroll-layers = <5>;
};

&trackball_listener {
    // &zip_xy_scaler の後ろにある数値 <分子 分母> で速度を調整できます。

    input-processors = <&zip_xy_scaler 3 2>;
};

/ {
    combos {
        compatible = "zmk,combos";

        context_menu {
            bindings = <&kp K_CONTEXT_MENU>;
            key-positions = <31 32>;
        };

        left_click {
            bindings = <&mkp MB1>;
            key-positions = <32 18>;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <19 32>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        KP_00: KP_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
            label = "KP_00";
        };

        //「ALt+↓」のメニュー誤作動防止マクロ

        alt_down_safe: alt_down_safe {
            label = "alt_down_safe";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_press>, <&kp LALT kp>;
        };

        //「ALt+↑」のメニュー誤作動防止マクロ

        alt_up_safe: alt_up_safe {
            label = "alt_up_safe";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_press>, <&kp LALT kp>;
        };

        //「ALt+←」のメニュー誤作動防止マクロ

        alt_left_safe: alt_left_safe {
            label = "alt_left_safe";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_press>, <&kp LALT kp>;
        };

        //「ALt+→」のメニュー誤作動防止マクロ

        alt_right_safe: alt_right_safe {
            label = "alt_right_safe";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_press>, <&kp LALT kp>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        escape: escape {
            compatible = "zmk,behavior-tap-dance";
            label = "ESCAPE";
            #binding-cells = <0>;
            bindings = <&none>, <&kp ESCAPE>;

            tapping-term-ms = <200>;
        };

        // チルダキー (通常: ~ / Shift: `)

        mm_tilde: mod_morph_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp TILDE>, <&kp GRAVE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // セミコロンキー (通常: : / Shift: ;)

        mm_colon: mod_morph_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // シングルクオーテーションキー (通常: " / Shift: ')

        mm_quote: mod_morph_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES>, <&kp SQT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB      &kp W             &kp E         &kp R        &kp T                                                 &kp Y         &kp U  &kp I        &kp O         &kp P
&mt LCTRL A  &kp S             &kp D         &kp F        &kp G               &escape            &kp DELETE     &kp H         &kp J  &kp K        &kp L         &mt RCTRL MINUS
&kp Z        &mt LEFT_SHIFT X  &kp C         &kp V        &kp B               &none              &kp F10        &kp N         &kp M  &lt 5 COMMA  &lt 4 PERIOD  &mt RIGHT_SHIFT SLASH
&kp Q        &none             &kp LEFT_WIN  &lt 2 SPACE  &mt LEFT_ALT SPACE  &kp LA(GRAVE)      &kp BACKSPACE  &lt 1 RETURN                                    &mo 6
            >;
        };

        FUNC_ARROW {
            bindings = <
&none      &kp LC(F1)      &none    &none   &kp LA(F4)                             &none           &none           &none           &none            &none
&kp LCTRL  &kp F1          &kp F2   &kp F3  &kp F4      &kp F5      &kp PAGE_UP    &alt_up_safe    &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW  &kp RIGHT_WIN
&none      &kp LEFT_SHIFT  &kp F6   &kp F7  &kp F8      &kp F9      &kp PAGE_DOWN  &alt_down_safe  &kp HOME        &kp DOWN_ARROW  &kp END          &none
&none      &kp F11         &kp F12  &none   &none       &none       &none          &none                                                            &none
            >;
        };

        SYMBOL_NUM {
            bindings = <
&none      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET                             &kp EQUAL     &kp N7  &kp N8  &kp N9  &mm_tilde
&kp LCTRL  &kp EXCLAMATION       &kp AT_SIGN            &kp HASH          &kp DOLLAR         &trans      &none          &kp PLUS      &kp N4  &kp N5  &kp N6  &mm_colon
&none      &kp LEFT_SHIFT        &kp PERCENT            &kp CARET         &kp AMPERSAND      &none       &kp BACKSLASH  &kp ASTERISK  &kp N1  &kp N2  &kp N3  &mm_quote
&none      &none                 &none                  &none             &none              &none       &none          &kp N0                                &KP_00
            >;
        };

        BLANC {
            bindings = <
&none  &none  &none  &none  &none                    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none                       &none
            >;
        };

        MOUSE {
            bindings = <
&none      &none           &none  &none  &none                              &none            &none     &none              &none  &none
&kp LCTRL  &none           &none  &none  &none  &trans      &none           &none            &mkp MB1  &mkp MB2           &none  &none
&none      &kp LEFT_SHIFT  &none  &none  &none  &none       &none           &none            &none     &kp K_APPLICATION  &none  &none
&none      &none           &none  &none  &none  &none       &alt_left_safe  &alt_right_safe                                      &none
            >;
        };

        SCROLL {
            bindings = <
&none      &none           &none  &none  &none                     &none  &none  &none  &none  &none
&kp LCTRL  &none           &none  &none  &none  &trans      &none  &none  &none  &none  &none  &none
&none      &kp LEFT_SHIFT  &none  &none  &none  &none       &none  &none  &none  &none  &none  &none
&none      &none           &none  &none  &none  &none       &none  &none                       &none
            >;
        };

        BT {
            bindings = <
&none  &none         &none         &none         &none                          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &none         &none         &none         &none  &none      &none        &none         &none         &none         &none         &bt BT_CLR
&none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none  &none      &bootloader  &none         &none         &none         &none         &bt BT_CLR_ALL
&none  &none         &none         &none         &none  &none      &none        &none                                                   &none
            >;
        };
    };
};
