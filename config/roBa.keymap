#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        left_click {
            bindings = <&mkp MB1>;
            key-positions = <18 21>;
        };

        right_cilck {
            bindings = <&mkp MB2>;
            key-positions = <19 21>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        KP_00: KP_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
            label = "KP_00";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W   &kp E   &kp R         &kp T                                          &kp Y        &kp U  &kp I      &kp O    &kp P
&mt LCTRL A       &kp S   &kp D   &kp F         &kp G        &kp ESCAPE         &kp RCTRL      &kp H        &kp J  &kp K      &kp L    &lt 5 MINUS
&mt LEFT_SHIFT Z  &kp X   &kp C   &kp V         &kp B        &kp F10            &mo 6          &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LEFT_WIN      &trans  &trans  &kp LEFT_WIN  &lt 1 SPACE  &kp LA(GRAVE)      &kp BACKSPACE  &lt 2 ENTER                             &kp DELETE
            >;
        };

        FUNC_ARROW {
            bindings = <
&kp TAB         &none           &none           &none   &none                               &none          &kp RC(RS(TAB))  &kp UP_ARROW    &kp RC(TAB)      &none
&kp LCTRL       &kp F1          &kp F2          &kp F3  &kp F4  &kp F5       &kp PAGE_UP    &kp HOME       &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp RCTRL
&kp LEFT_SHIFT  &kp F6          &kp F7          &kp F8  &kp F9  &kp F10      &kp PAGE_DOWN  &kp END        &none            &none           &none            &kp RSHFT
&kp LEFT_WIN    &kp LANGUAGE_2  &kp LANGUAGE_1  &none   &none   &none        &none          &kp RIGHT_ALT                                                    &kp RS(RG(S))
            >;
        };

        NUM_SYMBOL {
            bindings = <
&kp LEFT_ARROW  &kp N7  &kp N8  &kp N9        &kp RIGHT_ARROW                         &kp HASH         &kp DOLLAR  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp GRAVE
&kp LCTRL       &kp N4  &kp N5  &kp N6        &kp ASTERISK     &kp SLASH      &trans  &kp EXCLAMATION  &kp AT      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON
&kp LEFT_SHIFT  &kp N1  &kp N2  &kp NUMBER_3  &kp PLUS         &kp MINUS      &trans  &kp PERCENT      &kp CARET   &kp AMPERSAND         &kp ASTERISK           &kp SINGLE_QUOTE
&trans          &kp N0  &KP_00  &kp PERIOD    &kp EQUAL        &trans         &trans  &trans                                                                    &kp BACKSLASH
            >;
        };

        BLANC {
            bindings = <
&none  &none  &none  &none  &none                    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none                       &none
            >;
        };

        MOUSE {
            bindings = <
&none  &none  &none  &none  &none                         &none  &none     &none     &none  &none
&none  &none  &none  &none  &none  &kp ESCAPE      &none  &none  &mkp MB1  &mkp MB2  &none  &none
&none  &none  &none  &none  &none  &none           &none  &none  &none     &none     &none  &none
&none  &none  &none  &none  &none  &none           &none  &none                             &none
            >;
        };

        SCROLL {
            bindings = <
&none  &none  &none  &none  &none                         &none  &none     &none     &none  &none
&none  &none  &none  &none  &none  &kp ESCAPE      &none  &none  &mkp MB1  &mkp MB2  &none  &none
&none  &none  &none  &none  &none  &none           &none  &none  &none     &none     &none  &none
&none  &none  &none  &none  &none  &none           &none  &none                             &none
            >;
        };

        BT {
            bindings = <
&none  &none         &none         &none         &none                          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &none         &none         &none         &none  &none      &none        &none         &none         &none         &none         &bt BT_CLR
&none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none  &none      &bootloader  &none         &none         &none         &none         &bt BT_CLR_ALL
&none  &none         &none         &none         &none  &none      &none        &none                                                   &none
            >;
        };
    };
};
