#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    zip_temp_layer: zip_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
    };

    zip_xy_scaler: zip_xy_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_X INPUT_REL_Y>;
    };
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <4>;

    scroll-layers = <5>;
};

&trackball_listener {
    // &zip_xy_scaler の後ろにある数値 <分子 分母> で速度を調整できます。

    input-processors = <&zip_xy_scaler 3 2>, <&zip_temp_layer 4 250>;
};

/ {
    combos {
        compatible = "zmk,combos";

        left_click {
            bindings = <&mkp MB1>;
            key-positions = <18 21>;
        };

        right_cilck {
            bindings = <&mkp MB2>;
            key-positions = <19 21>;
        };

        CONTEXT_MENU {
            bindings = <&kp K_CONTEXT_MENU>;
            key-positions = <31 32>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        KP_00: KP_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
            label = "KP_00";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        escape: escape {
            compatible = "zmk,behavior-tap-dance";
            label = "ESCAPE";
            #binding-cells = <0>;
            bindings = <&none>, <&kp ESCAPE>;

            tapping-term-ms = <200>;
        };

        // チルダキー (通常: ~ / Shift: `)

        mm_tilde: mod_morph_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp TILDE>, <&kp GRAVE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // セミコロンキー (通常: : / Shift: ;)

        mm_colon: mod_morph_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // シングルクオーテーションキー (通常: " / Shift: ')

        mm_quote: mod_morph_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES>, <&kp SQT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB           &kp W          &kp E         &kp R        &kp T                                                 &kp Y        &kp U  &kp I      &kp O    &kp P
&mt LCTRL A       &kp S          &kp D         &kp F        &kp G               &escape            &kp DELETE     &kp H        &kp J  &kp K      &kp L    &lt 5 MINUS
&mt LEFT_SHIFT Z  &kp X          &kp C         &kp V        &kp B               &kp LCTRL          &lt 6 F10      &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp Q             &kp LG(SPACE)  &kp LEFT_WIN  &lt 2 SPACE  &mt LEFT_ALT SPACE  &kp LA(GRAVE)      &kp BACKSPACE  &lt 1 ENTER                             &kp RS(RG(S))
            >;
        };

        NUM_ARROW {
            bindings = <
&trans          &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none                                      &none     &none           &kp UP_ARROW    &none            &none
&kp LCTRL       &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS             &none          &none  &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END
&kp LEFT_SHIFT  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ASTERISK         &none          &none  &none     &kp PAGE_UP     &none           &kp PAGE_DOWN    &none
&none           &none         &trans        &kp NUMBER_0  &mt LEFT_ALT PERIOD  &kp EQUAL      &none  &none                                                      &none
            >;
        };

        FUNC_SYMBOL {
            bindings = <
&trans          &kp LC(F1)  &none    &none   &kp LA(F4)                                 &kp LBKT         &kp RBKT     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &mm_tilde
&kp LCTRL       &kp F1      &kp F2   &kp F3  &kp F4      &kp F5       &kp SEMICOLON     &kp EXCLAMATION  &kp AT_SIGN  &kp HASH              &kp AMPERSAND          &mm_colon
&kp LEFT_SHIFT  &kp F6      &kp F7   &kp F8  &kp F9      &kp F10      &kp SINGLE_QUOTE  &kp PERCENT      &kp CARET    &kp AMPERSAND         &kp BACKSLASH          &mm_quote
&none           &kp F11     &kp F12  &none   &none       &none        &none             &none                                                                      &none
            >;
        };

        BLANC {
            bindings = <
&none  &none  &none  &none  &none                    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none                       &none
            >;
        };

        MOUSE {
            bindings = <
&none           &none  &none  &none  &none                     &none  &none     &none     &none  &none
&kp LCTRL       &none  &none  &none  &none  &trans      &none  &none  &mkp MB1  &mkp MB2  &none  &mo 5
&kp LEFT_SHIFT  &none  &none  &none  &none  &none       &none  &none  &none     &none     &none  &none
&none           &none  &none  &none  &none  &none       &none  &none                             &none
            >;
        };

        SCROLL {
            bindings = <
&none           &none  &none  &none  &none                     &none  &none     &none     &none  &none
&kp LCTRL       &none  &none  &none  &none  &trans      &none  &none  &mkp MB1  &mkp MB2  &none  &none
&kp LEFT_SHIFT  &none  &none  &none  &none  &none       &none  &none  &none     &none     &none  &none
&none           &none  &none  &none  &none  &none       &none  &none                             &none
            >;
        };

        BT {
            bindings = <
&none  &none         &none         &none         &none                          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &none         &none         &none         &none  &none      &none        &none         &none         &none         &none         &bt BT_CLR
&none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none  &none      &bootloader  &none         &none         &none         &none         &bt BT_CLR_ALL
&none  &none         &none         &none         &none  &none      &none        &none                                                   &none
            >;
        };
    };
};
