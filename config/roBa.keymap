#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    zip_temp_layer: zip_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
    };

    // (既存の combos や macros などはそのまま残します)
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <4>;

    scroll-layers = <5>;
};

&trackball_listener {
    input-processors = <&zip_xy_scaler 3 2>, <&zip_temp_layer 4 200>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        left_click {
            bindings = <&mkp MB1>;
            key-positions = <18 21>;
        };

        right_cilck {
            bindings = <&mkp MB2>;
            key-positions = <19 21>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <37 16>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        KP_00: KP_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
            label = "KP_00";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB           &kp W  &kp E  &kp R         &kp T                                          &kp Y        &kp U  &kp I      &kp O    &kp P
&mt LCTRL A       &kp S  &kp D  &kp F         &kp G        &kp ESCAPE         &kp BACKSPACE  &kp H        &kp J  &kp K      &kp L    &lt 5 MINUS
&mt LEFT_SHIFT Z  &kp X  &kp C  &kp V         &kp B        &kp LCTRL          &kp F10        &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LEFT_WIN      &kp Q  &mo 6  &kp LEFT_ALT  &lt 1 SPACE  &kp LA(GRAVE)      &kp ENTER      &lt 2 SPACE                             &kp DELETE
            >;
        };

        FUNC_SYMBOL {
            bindings = <
&none           &kp LC(F1)  &none   &none   &kp LA(F4)                       &kp HASH         &kp DOLLAR  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp GRAVE
&kp LCTRL       &kp F1      &kp F2  &kp F3  &kp F4      &kp F5       &trans  &kp EXCLAMATION  &kp AT      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON
&kp LEFT_SHIFT  &kp F6      &kp F7  &kp F8  &kp F9      &kp F10      &trans  &kp PERCENT      &kp CARET   &kp AMPERSAND         &kp ASTERISK           &kp SINGLE_QUOTE
&none           &none       &none   &none   &none       &trans       &trans  &trans                                                                    &kp BACKSLASH
            >;
        };

        NUM_ARROW {
            bindings = <
&trans          &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9         &none                                &none          &none           &kp UP_ARROW    &none            &none
&kp LCTRL       &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6         &kp ASTERISK  &kp SLASH      &trans  &kp PAGE_UP    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp MINUS
&kp LEFT_SHIFT  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3         &kp PLUS      &kp MINUS      &trans  &kp PAGE_DOWN  &kp HOME        &none           &kp END          &kp RSHFT
&trans          &kp NUMBER_0  &KP_00        &mt LEFT_ALT PERIOD  &kp EQUAL     &trans         &none   &none                                                           &none
            >;
        };

        BLANC {
            bindings = <
&none  &none  &none  &none  &none                    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none                       &none
            >;
        };

        MOUSE {
            bindings = <
&none           &none  &none  &none  &none                     &none  &none     &none     &none  &none
&none           &none  &none  &none  &none  &trans      &none  &none  &mkp MB1  &mkp MB2  &none  &mo 5
&kp LEFT_SHIFT  &none  &none  &none  &none  &none       &none  &none  &none     &none     &none  &none
&none           &none  &none  &none  &none  &none       &none  &none                             &none
            >;
        };

        SCROLL {
            bindings = <
&none           &none  &none  &none  &none                     &none  &none     &none     &none  &none
&kp LCTRL       &none  &none  &none  &none  &trans      &none  &none  &mkp MB1  &mkp MB2  &none  &none
&kp LEFT_SHIFT  &none  &none  &none  &none  &none       &none  &none  &none     &none     &none  &none
&none           &none  &none  &none  &none  &none       &none  &none                             &none
            >;
        };

        BT {
            bindings = <
&none  &none         &none         &none         &none                          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &none         &none         &none         &none  &none      &none        &none         &none         &none         &none         &bt BT_CLR
&none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none  &none      &bootloader  &none         &none         &none         &none         &bt BT_CLR_ALL
&none  &none         &none         &none         &none  &none      &none        &none                                                   &none
            >;
        };
    };
};
