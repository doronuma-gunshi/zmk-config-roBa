#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    zip_xy_scaler: zip_xy_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_X INPUT_REL_Y>;
    };
};

&mt {
    flavor = "balanced";
    tapping-term-ms = <175>;
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <4>;

    scroll-layers = <5>;
};

&trackball_listener {
    // &zip_xy_scaler の後ろにある数値 <分子 分母> で速度を調整できます。

    input-processors = <&zip_xy_scaler 3 2>;
};

/ {
    combos {
        compatible = "zmk,combos";

        context_menu {
            bindings = <&kp K_CONTEXT_MENU>;
            key-positions = <31 32>;
        };

        left_click {
            bindings = <&mkp MB1>;
            key-positions = <32 18>;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <19 32>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 1 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        KP_00: KP_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
            label = "KP_00";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        escape: escape {
            compatible = "zmk,behavior-tap-dance";
            label = "ESCAPE";
            #binding-cells = <0>;
            bindings = <&none>, <&kp ESCAPE>;

            tapping-term-ms = <200>;
        };

        // チルダキー (通常: ~ / Shift: `)

        mm_tilde: mod_morph_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp TILDE>, <&kp GRAVE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // セミコロンキー (通常: : / Shift: ;)

        mm_colon: mod_morph_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // シングルクオーテーションキー (通常: " / Shift: ')

        mm_quote: mod_morph_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES>, <&kp SQT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB         &kp W  &kp E         &kp R               &kp T                                          &kp Y        &kp U  &kp I        &kp O         &kp P
&mt LCTRL A     &kp S  &kp D         &kp F               &kp G        &escape            &kp DELETE     &kp H        &kp J  &kp K        &kp L         &mt RCTRL MINUS
&kp LEFT_SHIFT  &kp X  &kp C         &kp V               &kp B        &none              &lt 6 F10      &kp N        &kp M  &lt 5 COMMA  &lt 4 PERIOD  &mt RIGHT_SHIFT RETURN
&kp Z           &kp Q  &kp LEFT_WIN  &mt LEFT_ALT SPACE  &lt 1 SPACE  &kp LA(GRAVE)      &kp BACKSPACE  &lt 2 SPACE                                    &kp SLASH
            >;
        };

        FUNC_ARROW {
            bindings = <
&trans      &kp LC(F1)  &none    &none   &kp LA(F4)                       &none          &none           &none           &none            &none
&kp LCTRL   &kp F1      &kp F2   &kp F3  &kp F4      &kp F5       &trans  &kp PAGE_UP    &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW  &kp RIGHT_WIN
&kp LSHIFT  &kp F6      &kp F7   &kp F8  &kp F9      &kp F10      &trans  &kp PAGE_DOWN  &kp HOME        &kp DOWN_ARROW  &kp END          &none
&none       &kp F11     &kp F12  &none   &none       &none        &none   &kp LEFT_ALT                                                    &none
            >;
        };

        NUM_SYMBOL {
            bindings = <
&none           &kp N7  &kp N8  &kp N9  &kp EQUAL                         &kp LBKT         &kp RBKT     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &mm_tilde
&kp LCTRL       &kp N4  &kp N5  &kp N6  &kp PLUS      &trans      &trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH              &kp DOLLAR             &mm_colon
&kp LEFT_SHIFT  &kp N1  &kp N2  &kp N3  &kp ASTERISK  &trans      &trans  &kp PERCENT      &kp CARET    &kp AMPERSAND         &kp BACKSLASH          &mm_quote
&none           &none   &none   &kp N0  &kp DOT       &none       &none   &none                                                                      &none
            >;
        };

        BLANC {
            bindings = <
&none  &none  &none  &none  &none                    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none                       &none
            >;
        };

        MOUSE {
            bindings = <
&none           &none  &none  &none  &none                     &none  &none     &none     &none  &none
&kp LCTRL       &none  &none  &none  &none  &trans      &none  &none  &mkp MB1  &mkp MB2  &none  &none
&kp LEFT_SHIFT  &none  &none  &none  &none  &trans      &none  &none  &none     &none     &none  &none
&none           &none  &none  &none  &none  &none       &none  &none                             &none
            >;
        };

        SCROLL {
            bindings = <
&none           &none  &none  &none  &none                     &none  &none  &none  &none  &none
&kp LCTRL       &none  &none  &none  &none  &trans      &none  &none  &none  &none  &none  &none
&kp LEFT_SHIFT  &none  &none  &none  &none  &trans      &none  &none  &none  &none  &none  &none
&none           &none  &none  &none  &none  &none       &none  &none                       &none
            >;
        };

        BT {
            bindings = <
&none  &none         &none         &none         &none                          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &none         &none         &none         &none  &none      &none        &none         &none         &none         &none         &bt BT_CLR
&none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none  &none      &bootloader  &none         &none         &none         &none         &bt BT_CLR_ALL
&none  &none         &none         &none         &none  &none      &none        &none                                                   &none
            >;
        };
    };
};
