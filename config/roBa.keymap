#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    zip_temp_layer: zip_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
    };

    zip_xy_scaler: zip_xy_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_X INPUT_REL_Y>;
    };
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <4>;

    scroll-layers = <5>;
};

&trackball_listener {
    // &zip_xy_scaler の後ろにある数値 <分子 分母> で速度を調整できます。

    input-processors = <&zip_xy_scaler 3 2>, <&zip_temp_layer 4 250>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        left_click {
            bindings = <&mkp MB1>;
            key-positions = <18 19>;
        };

        right_cilck {
            bindings = <&mkp MB2>;
            key-positions = <19 20>;
        };

        CONTEXT_MENU {
            bindings = <&kp K_CONTEXT_MENU>;
            key-positions = <31 32>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        KP_00: KP_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
            label = "KP_00";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        escape: escape {
            compatible = "zmk,behavior-tap-dance";
            label = "ESCAPE";
            #binding-cells = <0>;
            bindings = <&none>, <&kp ESCAPE>;

            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB           &kp W          &kp E    &kp R         &kp T                                                     &kp Y        &kp U  &kp I      &kp O    &kp P
&mt LCTRL A       &kp S          &kp D    &kp F         &kp G        &escape            &kp BACKSPACE             &kp H        &kp J  &kp K      &kp L    &lt 5 MINUS
&mt LEFT_SHIFT Z  &kp X          &kp C    &kp V         &kp B        &kp F10            &mt RCTRL K_CONTEXT_MENU  &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LEFT_WIN      &kp LG(SPACE)  &lt 6 Q  &kp LEFT_ALT  &lt 2 SPACE  &kp LA(GRAVE)      &kp ENTER                 &lt 1 SPACE                             &kp DELETE
            >;
        };

        NUM_SYMBOL {
            bindings = <
&none           &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK                         &kp HASH         &kp DOLLAR  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp RS(GRAVE)
&kp LCTRL       &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS      &kp SLASH      &trans  &kp EXCLAMATION  &kp AT      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RS(SEMICOLON)
&kp LEFT_SHIFT  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS     &trans         &trans  &kp PERCENT      &kp CARET   &kp AMPERSAND         &kp ASTERISK           &kp RS(SINGLE_QUOTE)
&trans          &kp NUMBER_0  &KP_00        &kp PERIOD    &kp EQUAL     &trans         &none   &none                                                                     &kp RS(BACKSLASH)
            >;
        };

        FUNC_ARROW {
            bindings = <
&trans          &kp LC(F1)  &none    &none   &kp LA(F4)                      &none          &none           &kp UP_ARROW    &none            &none
&kp LCTRL       &kp F1      &kp F2   &kp F3  &kp F4      &kp F5      &trans  &kp PAGE_UP    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp RCTRL
&kp LEFT_SHIFT  &kp F6      &kp F7   &kp F8  &kp F9      &trans      &trans  &kp PAGE_DOWN  &kp HOME        &none           &kp END          &kp RSHFT
&trans          &kp F11     &kp F12  &none   &none       &none       &none   &kp LEFT_ALT                                                    &none
            >;
        };

        BLANC {
            bindings = <
&none  &none  &none  &none  &none                    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none      &none  &none                       &none
            >;
        };

        MOUSE {
            bindings = <
&none           &none  &none  &none  &none                     &none  &none     &kp UP_ARROW    &none     &none
&kp LCTRL       &none  &none  &none  &none  &trans      &none  &none  &mkp MB1  &kp DOWN_ARROW  &mkp MB2  &mo 5
&kp LEFT_SHIFT  &none  &none  &none  &none  &none       &none  &none  &none     &none           &none     &kp RIGHT_SHIFT
&none           &none  &none  &none  &none  &none       &none  &none                                      &none
            >;
        };

        SCROLL {
            bindings = <
&none           &none  &none  &none  &none                     &none  &none     &none  &none     &none
&kp LCTRL       &none  &none  &none  &none  &trans      &none  &none  &mkp MB1  &none  &mkp MB2  &none
&kp LEFT_SHIFT  &none  &none  &none  &none  &none       &none  &none  &none     &none  &none     &none
&none           &none  &none  &none  &none  &none       &none  &none                             &none
            >;
        };

        BT {
            bindings = <
&none  &none         &none         &none         &none                          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &none         &none         &none         &none  &none      &none        &none         &none         &none         &none         &bt BT_CLR
&none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none  &none      &bootloader  &none         &none         &none         &none         &bt BT_CLR_ALL
&none  &none         &none         &none         &none  &none      &none        &none                                                   &none
            >;
        };
    };
};
